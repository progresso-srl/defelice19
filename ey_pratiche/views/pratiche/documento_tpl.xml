<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- tree view -->
        <record id="ey_pratiche_documento_tpl_tree_view" model="ir.ui.view">
            <field name="name">ey_pratiche.documento_tpl.tree</field>
            <field name="model">ey_pratiche.documento_tpl</field>
            <field name="arch" type="xml">
                <list string="Documenti" delete="false">
                    <field name="name" />
                    <field name="format" />
                    <button type="object" name="apri_py3o_template" string="Apri template" class="btn btn-primary" groups="ey_pratiche.group_ey_pratiche_manager"/>
                    <!-- <field name="document" widget="binary" filename="document_fname" attrs="{'invisible':[('id','!=',False)]}"/> -->
                    <field name="document_fname" invisible="1"/>
                    <field name="duplica" />
                    <field name="priority" placeholder="Priorità" />
                </list>
            </field>
        </record>
        <!-- search view -->
        <record id="ey_pratiche_documento_tpl_search_view" model="ir.ui.view">
            <field name="name">ey_pratiche.documento_tpl.select</field>
            <field name="model">ey_pratiche.documento_tpl</field>
            <field name="arch" type="xml">
                <search>
                    <field name="tpl_id" />
                    <field name="name" />
                </search>
            </field>
        </record>
        <!-- form view -->
        <record id="ey_pratiche_documento_tpl_form_view" model="ir.ui.view">
            <field name="name">ey_pratiche.documento_tpl.form</field>
            <field name="model">ey_pratiche.documento_tpl</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <form string="Documenti">
                    <sheet>
                        <div class="oe_title" style="width: 80%">
                            <h1>
                                <field name="id" invisible="1" />
                                <field name="name" placeholder="Nome"/>
                            </h1>
                            <h4>
                                <label for="priority">Priorità</label>
                                <field name="priority" placeholder="Priorità" />
                            </h4>
                        </div>
                    
                        <group>
                            <group>
                                <field name="format"/>
                                <field name="duplica" />
                            </group>
                            <group>
                                <button type="object" name="apri_py3o_template" string="Apri template" class="btn btn-primary" groups="ey_pratiche.group_ey_pratiche_manager"/>
                                <field name="document" widget="binary" filename="document_fname"/> 
                            </group>
                        </group>
                          
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>       

        
        <record id="ey_pratiche_pratica_list_view" model="ir.ui.view">
            <field name="name">ey_pratiche.pratica.list</field>
            <field name="model">ey_pratiche.pratica</field>
            <field name="arch" type="xml">
                <list string="Pratiche">
                    <field name="name"/>
                    <field name="riferimento_pratica" string="N. Protocollo / Rif. pratica"/>
                    <field name="state"/> 
                    <field name="data_pratica" />
                    <field name="nave_id"/>
                    <field name="partner_id"/>
                    <field name="numero_registro_nave"/>
                    <field name="porto_nave"/>
                    <field name="utilizzo_nave"/>
                    <field name="ultima_attivita"/>
                    <field name="user_id"/>
                    <field name="tipo_pratica"/>
                    <field name="tipo_template"/>
                </list>
            </field>
        </record>
      
        
        <record id="ey_pratiche_pratica_search_view" model="ir.ui.view">
            <field name="name">ey_pratiche.pratica.search</field>
            <field name="model">ey_pratiche.pratica</field>
            <field name="arch" type="xml">
                <search string="Cerca Pratiche">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="nave_id"/>
                    <field name="state"/>
                </search>
            </field>
        </record>

        <record id="ey_pratiche_pratica_form_view" model="ir.ui.view">
            <field name="name">ey_pratiche.pratica.form</field>
            <field name="model">ey_pratiche.pratica</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <form string="Pratiche" >
                    <header>
                        <button string="Preventivo"
                                name="stato_preventivo" type="object"/>
                         <button string="In corso" class="oe_edit_only"
                                name="stato_in_corso" type="object"/>
                        <button string="Da fatturare" class="oe_edit_only"
                                name="stato_da_fatturare" type="object"/>
                        <button string="Fatturata" class="oe_edit_only"
                                name="stato_fatturata" type="object"/>
                        <button string="Pagata" class="oe_edit_only"
                                name="stato_pagata" type="object"/>
                        <button string="Sospesa" class="oe_edit_only"
                                name="stato_sospesa" type="object"/>
                        <button string="Annullata" class="oe_edit_only"
                                name="stato_annullata" type="object"/> 
                        <field name="state" widget="statusbar"/>

                    </header>
                    <sheet>
                        <div class="oe_title" style="width: 80%">
                            <h1>
                                <field name="name" placeholder="Nome"/>
                            </h1>
                            <h4>
                                <label for="user_id" string="Responsabile"/>
                                <field name="user_id" placeholder="Responsabile" options="{'no_quick_create':True}"/>
                            </h4>
                        </div>
                        <notebook>
                            <page name="generale" string="Generale">
                               
                                <group>
                                    <group name="info_pratica_sx">
                                        <field name="tpl_id" placeholder="Nome"
                                               options="{'no_create': True, 'no_open': True, 'limit': 1000}"
                                               domain="[('stato_template', '=', 'attivo')]" />
                                        <field name="data_pratica"/>
                                      
                                        <!--<field name="state"/> -->
                                        <!--TODO QUANDO SI COMPILA?-->
                                        <field name="tipo_pratica" readonly="1"/>
                                        <field name="riferimento_pratica"  readonly="1"/>
                                        <field name="protocollo_data" readonly="1"/>
                                    </group>
                                    <group name="info_pratica_dx">
                                        <field name="partner_id" options="{'no_quick_create':True}"/>
                                        <field name="nave_id" options="{'no_quick_create':True}"/>
                                        <field name="partner_riferimento_id" domain="[('anagrafica_ey', '=', True)]"
                                               options="{'no_quick_create':True}"/>
                                        <!-- <field name="tipo_documento_id"
                                               options="{'no_quick_create':True}"/> -->
                                        <field name="qualifica_id"
                                               options="{'no_quick_create':True}"/>
                                        <field name="soggetto_fatturazione_id"
                                            options="{'no_quick_create':True}"/>
                                    </group>
                                </group>
                                <!-- TODO testare pratica sted -->
                                 <group string="STED">
                                    <group>
                                        <field name="sted_data_pratica" />
                                        <!-- <field name="sted_ente_rilascio" readonly="1"/> -->
                                    </group>
                                    <group>
                                        <field name="sted_nr_dci" readonly="1"/>
                                        <field name="sted_nr_pratica" />
                                        <field name="sted_data_dci" readonly="1"/>
                                    </group>
                                </group> 
                                <group string="Referenti pratica"> <!--TODO CAPIRE COME FUNZIONA PERCHE NON FA COMPILARE PARTNER E NAVE -->
                                   <field name="contatto_pratica_ids" nolabel="1">
                                        <list editable="top">
                                            <field name="name"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Campi nave">
                                    <group>
                                        <field name="nome_nave" readonly="1"/>
                                        <field name="tipo_registro_nave" readonly="1"/>
                                        <field name="numero_registro_nave" readonly="1"/>
                                        <field name="bandiera_nave" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="riferimento_nave" readonly="1"/>
                                        <field name="porto_nave" readonly="1"/>
                                        <field name="stazza_lorda_nave" readonly="1"/>
                                        <field name="utilizzo_nave" readonly="1"/>
                                    </group>
                                </group> 
                                <group string="Campi marittimo">
                                    <group>
                                        <field name="cognome_marittimo" readonly="1"/>
                                        <field name="cf_marittimo" readonly="1"/>
                                        <field name="stato_civile_marittimo" readonly="1"/>
                                        <field name="tipo_documento_marittimo" readonly="1"/>
                                        <field name="luogo_rilascio_documento_marittimo" readonly="1"/>
                                        <field name="documento_marittimo_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="nome_marittimo" readonly="1"/>
                                        <field name="cittadinanza_marittimo" readonly="1"/>
                                        <field name="indirizzo_marittimo_id" readonly="1"/>
                                        <field name="numero_documento_marittimo" readonly="1"/>
                                        <field name="categoria_documento_marittimo" readonly="1"/>
                                        <field name="rilascio_documento_marittimo" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Armatori">
                                    <field name="armatore_ids" nolabel="1">
                                        <list editable="bottom" create="false" delete="false">
                                            <field name="cognome" readonly="1"/>
                                            <field name="nome" readonly="1"/>
                                            <field name="identificatore"/>
                                            <field name="indirizzo_id" readonly="1"/>
                                            <field name="fiscalcode" readonly="1"/>
                                            <field name="stato_civile" readonly="1"/>
                                            <button type="object" string="Vedi" name="get_partner"
                                                    help="Visualizza anagrafica collegata"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Proprietari">
                                    <field name="proprietario_ids" nolabel="1">
                                        <list editable="bottom" create="false" delete="false">
                                            <field name="cognome" readonly="1"/>
                                            <field name="nome" readonly="1"/>
                                            <field name="identificatore"/>
                                            <field name="indirizzo_id" readonly="1"/>
                                            <field name="fiscalcode" readonly="1"/>
                                            <field name="stato_civile" readonly="1"/>
                                            <field name="carati" readonly="1" />
                                            <button type="object" string="Vedi" name="get_partner"
                                                    help="Visualizza anagrafica collegata"/>
                                        </list>
                                    </field>
                                </group> 
                                <group string="Campi soggetto">
                                    <group>
                                        <field name="cognome_soggetto" readonly="1"/>
                                        <field name="cf_soggetto" readonly="1"/>
                                        <field name="stato_civile_soggetto" readonly="1"/>
                                        <field name="tipo_documento_soggetto" readonly="1"/>
                                        <field name="luogo_rilascio_documento_soggetto" readonly="1"/>
                                        <field name="documento_soggetto_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="nome_soggetto" readonly="1"/>
                                        <field name="cittadinanza_soggetto" readonly="1"/>
                                        <field name="indirizzo_soggetto_id" readonly="1"/>
                                        <field name="numero_documento_soggetto" readonly="1"/>
                                        <field name="categoria_documento_soggetto" readonly="1"/>
                                        <field name="rilascio_documento_soggetto" readonly="1"/>
                                    </group>
                                </group>
                                <group string="Altri soggetti">
                                    <field name="rappresentante_ids" nolabel="1">
                                        <list editable="bottom" create="false" delete="false">
                                            <field name="cognome" readonly="1"/>
                                            <field name="nome" readonly="1"/>
                                            <field name="identificatore"/>
                                            <field name="indirizzo_id" readonly="1"/>
                                            <field name="fiscalcode" readonly="1"/>
                                            <field name="ruolo" readonly="1"/>
                                            <field name="testo_descrittivo"/>
                                            <button type="object" string="Vedi" name="get_partner"
                                                    help="Visualizza anagrafica collegata"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Equipaggio">
                                    <field name="equipaggio_ids" nolabel="1">
                                        <list editable="bottom" create="false" delete="false">
                                            <field name="cognome" readonly="1"/>
                                            <field name="nome" readonly="1"/>
                                            <field name="identificatore"/>
                                            <field name="inizio" readonly="1"/>
                                            <field name="fine" readonly="1"/>
                                            <field name="data_imbarco" readonly="1"/>
                                            <field name="data_sbarco" readonly="1"/>
                                            <field name="ruolo" readonly="1"/>
                                            <button type="object" string="Vedi" name="get_partner"
                                                    help="Visualizza anagrafica collegata"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Enti">
                                    <field name="ente_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="id" invisible="1"/>
                                            <field name="partner_id"/>
                                            <field name="denominazione" readonly="1"/>
                                            <field name="sede" readonly="1"/>
                                            <field name="ufficio" readonly="1"/>
                                            <field name="codice_ufficio"  readonly="1"/>
                                            <field name="identificatore"/>
                                            <field name="indirizzo_id" readonly="1"/>
                                            <field name="fiscalcode" readonly="1"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Chiavi">
                                    <field name="chiave_ids" nolabel="1">
                                        <list editable="bottom" create="false" delete="false"
                                              colors="blue:is_valore==True">
                                       
                                            <field name="descrizione" readonly="1"/>
                                            <field name="chiave" readonly="1"/>
                                            <field name="valore"/>
                                            <field name="is_valore" invisible="1"/>
                                            <field name="priority" readonly="1"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Reports">
                                    <field name="report_ids" nolabel="1" readonly="1">
                                        <list editable="bottom">
                                            <field name="report_id" readonly="1"/>
                                            <field name="priority"/>
                                            <button name="button_stampa_pratica" string="Stampa documento"
                                                    class="oe_highlight" type="object"/>
                                        </list>
                                    </field>
                                </group> 
                            </page>
                            <page name="info" string="Info e documenti">
                                <group string="Info operatore">
                                    <field name="info_operatore" readonly="1"/>
                                </group>
                                <group string="Allegati info operatore">
                                    <field name="allegati" nolabel="1" readonly="1">
                                        <list editable="bottom">
                                            <field name="name" readonly="1"/>
                                            <field name="document" filename="document_fname" readonly="1"/>
                                            <field name="document_fname" invisible="1"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Documenti pratica">
                                    <field name="documenti_pratica_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="name"/>
                                            <field name="document" filename="document_fname"/>
                                            <field name="document_fname" invisible="1"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page name="attivita" string="Attività">
                                <!-- <group string="Attività di sistema">
                                    <field name="att_sistema_ids" readonly="1" nolabel="1">
                                        <tree editable="top">
                                            <field name="data"/>
                                            <field name="operatore_id"/>
                                            <field name="descrizione"/>
                                        </tree>
                                    </field>
                                </group> -->
                                <group string="Attività svolte dall'operatore">
                                    <field name="att_operatore_ids" nolabel="1">
                                        <list editable="top">
                                            <field name="data"/>
                                            <field name="operatore_id" options="{'no_quick_create':True}"/>
                                            <field name="descrizione"/>
                                            <field name="document" filename="document_fname"/>
                                            <field name="document_fname" invisible="1"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page name="follow_up" string="Follow up">
                                <field name="follow_up_ids" nolabel="1"/>
                            </page>
                            <page name="pratiche_collegate" string="Pratiche collegate">
                                <!--TODO VA FATTO COME PER LE NORMATIVE CHE FAI LA COSA SPECULARE PER I RECORD COLLEGATI? -->
                                <field name="id" invisible="1"/>
                                <field name="pratiche_collegate" options="{'no_create': True}"
                                       domain="[('id', '!=', id)]">
                                    <list>
                                        <field name="name"/>
                                        <field name="tipo_pratica"/>
                                        <field name="data_pratica"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page name="alerts" string="Alerts">
                                <field name="alert_ids">
                                    <list editable="top">
                                        <field name="data"/>
                                        <field name="operatore_id"/>
                                        <field name="descrizione"/>
                                        <field name="attivo"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <div class="oe_chatter">
                            <!-- <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/> -->
                            <field name="message_ids" widget="mail_thread"/>
                        </div>
                        <group invisible="1">
                            <field name="id" />
                            <field name="tipo_template"/>
                        </group>
                       
                    </sheet>
                </form>
            </field>
        </record>

           <!-- action per creare un tpl -->
           <record id="ey_pratiche_pratica_action" model="ir.actions.act_window">
            <field name="name">Pratiche</field>
            <field name="res_model">ey_pratiche.pratica</field>
            <field name="context">{'search_ey_default_pratiche_my_and_visibili': 1}</field>
            <field name="view_mode">list,form</field>
        </record>
       

        <!--crea la voce del menu -->
        <menuitem
                id="ey_pratiche_pratica_menu" name="Pratiche"
                parent="ey_pratiche.configuratore_pratiche_menu"
                action="ey_pratiche_pratica_action"
                sequence="20"
        />


       
    </data>
    
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <record id="ey_pratiche_follow_up_pratica_tree_view" model="ir.ui.view">
            <field name="name">ey_pratiche.follow_up_pratica.tree</field>
            <field name="model">ey_pratiche.follow_up_pratica</field>
            <field name="arch" type="xml">
                <list string="Follow up">
                    <field name="data"/>
                    <field name="operatore_id"/>
                    <field name="oggetto"/>
                    <field name="prev_descrizione"/>
                    <field name="document" filename="document_fname"/>
                    <field name="document_fname" invisible="1"/>
                </list>
            </field>
        </record>

        <record id="ey_pratiche_follow_up_pratica_search_view" model="ir.ui.view">
            <field name="name">ey_pratiche.follow_up_pratica.search</field>
            <field name="model">ey_pratiche.follow_up_pratica</field>
            <field name="arch" type="xml">
                <search>
                    <field name="pratica_id"/>
                </search>
            </field>
        </record>

        <record id="ey_pratiche_follow_up_pratica_form_view" model="ir.ui.view">
            <field name="name">ey_pratiche.follow_up_pratica.form</field>
            <field name="model">ey_pratiche.follow_up_pratica</field>
            <field name="arch" type="xml">
                <form string="Follow up" >
                    <sheet>
                        <notebook>
                            <page string="Generale">
                                <group>
                                    <field name="data"/>
                                    <field name="operatore_id"/>
                                    <field name="oggetto"/>
                                </group>
                                <group>
                                    <field name="document" filename="document_fname"/>
                                    <field name="document_fname" invisible="1"/>
                                    <field name="descrizione"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ey_pratiche_follow_up_pratica_action" model="ir.actions.act_window">
            <field name="name">Follow up</field>
            <field name="res_model">ey_pratiche.follow_up_pratica</field>
            <field name="view_mode">list,form</field>
        </record>
        
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="ey_pratiche_tpl_tree_view" model="ir.ui.view">
            <field name="name">ey_pratiche.tpl.tree</field>
            <field name="model">ey_pratiche.tpl</field>
            <field name="arch" type="xml">
                <list string="Template pratiche">
                    <field name="name"/>
                    <field name="versione"/>
                    <field name="tipo_template"/>
                    <field name="tipo_pratica"/>
                    <field name="stato_template"/>
                </list>
            </field>
        </record>

        <record id="ey_pratiche_tpl_search_view" model="ir.ui.view">
            <field name="name">ey_pratiche.tpl.search</field>
            <field name="model">ey_pratiche.tpl</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="tipo_template"/>
                    <field name="tipo_pratica" />
                    <field name="versione"/>

                    <group>
                        <filter name="tpl_attivi" string="Attivi" domain="[('stato_template','=', 'attivo')]"/>
                        <filter name="soggetti" string="Soggetti" domain="[('tipo_template','=', 'soggetti')]"/>
                        <filter name="navi" string="Navi" domain="[('tipo_template','=', 'navi')]"/>
                    </group>

                </search>
            </field>
        </record> 
          

        <record id="ey_pratiche_tpl_form_view" model="ir.ui.view">
            <field name="name">ey_pratiche.tpl.form</field>
            <field name="model">ey_pratiche.tpl</field>
            <field name="arch" type="xml">
                <form string="Template pratiche" >
                    <header>
                        <button name="button_duplica" string="Duplica" class="oe_highlight" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title" style="width: 80%">
                            <h1>
                               
                                <field name="name" placeholder="Nome"/>
                            </h1>
                            <h4>
                                <field name="versione" placeholder="versione"/>
                            </h4>
                        </div>
                        
                        <group>
                            <group>
                                <field name="tipo_pratica"/>
                                <field name="tipo_template"/>
                            </group>
                            <group>
                                <field name="stato_template"/>
                            </group>

                        </group>
                        <group string="Chiavi">
                            <field name="chiave_ids" nolabel="1">
                                <list editable="top">
                                    <field name="chiave"/>
                                    <field name="descrizione"/>
                                    <field name="tipo_chiave"/>
                                    <field name="valore"/>
                                    <field name="priority"/>
                                </list>
                            </field>
                        </group>
                        <group string="Documenti (per report)"> 
                            <field name="document_ids" nolabel="1"/>
                        </group>
                        <group string="Info operatore">
                            <field name="info_operatore"/>
                        </group>
                        <group string="Allegati">
                            <field name="allegato_ids" nolabel="1">                             
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="document" widget="binary" filename="document_fname"/>
                                    <field name="document_fname" invisible="1"/>
                                </list>
                            </field>
                        </group>
                        <group invisible="1">
                            <field name="id"/>
                        </group>
                           
                    </sheet>
                </form>
                </field>
            </record>

       
        <record id="ey_pratiche_tpl_action" model="ir.actions.act_window">
            <field name="name">Template pratiche</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ey_pratiche.tpl</field>
            <field name="context">{'search_default_tpl_attivi': 1}</field>
            <field name="view_mode">list,form</field>
        </record>
       


      
        <menuitem
                id="ey_pratiche_tpl_menu" name="Templates"
                parent="ey_pratiche.configuratore_pratiche_menu"
                action="ey_pratiche_tpl_action"    
                groups="group_ey_pratiche_manager"            
        />

    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="ey_pratiche_indirizzo_partner_tree_view" model="ir.ui.view">
            <field name="name">ey_pratiche.indirizzo_partner.tree</field>
            <field name="model">ey_pratiche.indirizzo_partner</field>
            <field name="arch" type="xml">
                <list string="Indirizzo">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="ey_pratiche_indirizzo_partner_form_view" model="ir.ui.view">
            <field name="name">ey_pratiche.indirizzo_partner.form</field>
            <field name="model">ey_pratiche.indirizzo_partner</field>
            <field name="arch" type="xml">
                <form string="Indirizzo" version="7.0">
                    <sheet>
                        <div class="oe_title" style="width: 80%">
                            <h1>
                                <field name="name" placeholder="Nome" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="street" readonly="1" />
                                <field name="city" readonly="1" />
                                <field name="zip" readonly="1" />
                            </group>
                            <group>
                                <field name="street2" readonly="1" />
                                <field name="state" readonly="1" />
                                <field name="country" readonly="1" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- action per creare un tpl -->
        <record id="ey_pratiche_indirizzo_partner_action" model="ir.actions.act_window">
            <field name="name">Indirizzo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ey_pratiche.indirizzo_partner</field>
            <field name="view_type">form</field>
            <field name="filter" eval="True"/>
            <field name="view_mode">list,form</field>
        </record>
        <record id="ey_pratiche_indirizzo_partner_tree_view_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="0"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="ey_pratiche_indirizzo_partner_tree_view"/>
            <field name="act_window_id" ref="ey_pratiche_indirizzo_partner_action"/>
        </record>
        <record id="ey_pratiche_indirizzo_partner_form_view_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ey_pratiche_indirizzo_partner_form_view"/>
            <field name="act_window_id" ref="ey_pratiche_indirizzo_partner_action"/>
        </record>

    </data>
</odoo>

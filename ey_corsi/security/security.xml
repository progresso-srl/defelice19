<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_ey_corsi_category" model="ir.module.category">
            <field name="name">E-Yacht Corsi</field>
            <field name="description">Permessi sui corsi ed esami gestiti da E-Yacht</field>
            <field name="sequence">11</field>
        </record>

        <record id="res_groups_privilege_ey_corsi" model="res.groups.privilege">
            <field name="name">E-Yacht Corsi</field>
            <field name="category_id" ref="module_ey_corsi_category"/>
        </record>

        <!-- v12: gruppo dedicato che vede/modifica il tab "Loghi e Templates" (loghi, ODT,
             chiavi) sui template corso/esame; ogni manager E-Yacht Corsi lo eredita. -->
        <record id="group_ey_corsi_template_manager" model="res.groups">
            <field name="name">Gestione template</field>
            <field name="privilege_id" ref="res_groups_privilege_ey_corsi"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ey_corsi_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_ey_corsi"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_ey_corsi_template_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root'))]"/>
        </record>

        <record id="group_ey_corsi_user" model="res.groups">
            <field name="name">Utente</field>
            <field name="privilege_id" ref="res_groups_privilege_ey_corsi"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>

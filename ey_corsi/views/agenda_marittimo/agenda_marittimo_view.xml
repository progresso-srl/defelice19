<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ey_corsi_agenda_marittimo_list_view" model="ir.ui.view">
        <field name="name">ey_corsi.agenda_marittimo.list</field>
        <field name="model">ey_corsi.agenda_marittimo</field>
        <field name="arch" type="xml">
            <list string="Agenda marittimo" editable="top">
                <field name="name" readonly="categoria_name == 'Scadenza Certificato Nave'"/>
                <field name="categoria_id" readonly="categoria_name == 'Scadenza Certificato Nave'"/>
                <field name="categoria_name" column_invisible="1"/>
                <field name="data_alert" readonly="categoria_name == 'Scadenza Certificato Nave'"/>
                <field name="data_scadenza" readonly="categoria_name == 'Scadenza Certificato Nave'"/>
                <field name="completato"/>
            </list>
        </field>
    </record>

    <record id="ey_corsi_agenda_marittimo_search_view" model="ir.ui.view">
        <field name="name">ey_corsi.agenda_marittimo.select</field>
        <field name="model">ey_corsi.agenda_marittimo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="categoria_id"/>
                <field name="completato"/>
                <separator/>
                <filter name="scadenze_visibili" string="Alert"
                        domain="[('data_alert','&lt;=',context_today().strftime('%Y-%m-%d')),
                                 ('completato','=',False)]"/>
                <group name="groupby">
                    <filter name="group_agenda_marittimo_categoria" string="Per categoria"
                            context="{'group_by':'categoria_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ey_corsi_agenda_marittimo" model="ir.actions.act_window">
        <field name="name">Agenda marittimo</field>
        <field name="res_model">ey_corsi.agenda_marittimo</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="ey_corsi_agenda_marittimo_search_view"/>
        <field name="context">{'search_default_scadenze_visibili': 1}</field>
    </record>

</odoo>

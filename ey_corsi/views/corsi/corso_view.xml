<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ey_corsi_corso_list_view" model="ir.ui.view">
        <field name="name">ey_corsi.corso.list</field>
        <field name="model">ey_corsi.corso</field>
        <field name="arch" type="xml">
            <list string="Corsi">
                <field name="template_id"/>
                <field name="data_inizio"/>
                <field name="data_fine"/>
                <field name="prezzo_corso"/>
            </list>
        </field>
    </record>

    <!-- NON portati: i filtri v12 "corsi_con_esame"/"corsi_da_validare" referenziano un campo
         data_esame che non esiste (mai esistito) sul modello ey_corsi.corso: sono filtri
         rotti già in v12 (avrebbero sollevato un errore se cliccati), non riportati qui. -->
    <record id="ey_corsi_corso_search_view" model="ir.ui.view">
        <field name="name">ey_corsi.corso.search</field>
        <field name="model">ey_corsi.corso</field>
        <field name="arch" type="xml">
            <search>
                <field name="template_id"/>
                <field name="prefisso"/>
                <field name="codice_unico"/>
                <separator/>
                <filter name="corsi_attivi" string="Corsi attivi"
                        domain="[('data_inizio','&lt;=',context_today().strftime('%Y-%m-%d')),
                                 ('data_fine','&gt;=',context_today().strftime('%Y-%m-%d')),
                                 ('annullato','=',False)]"/>
                <filter name="corsi_terminati" string="Corsi terminati"
                        domain="[('data_fine','&lt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="corsi_futuri" string="Corsi futuri"
                        domain="[('data_inizio','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="corsi_attivi_o_futuri" string="Corsi attivi o futuri"
                        domain="[('annullato','=',False), '|',
                                 '&amp;', ('data_inizio','&lt;=',context_today().strftime('%Y-%m-%d')), ('data_fine','&gt;=',context_today().strftime('%Y-%m-%d')),
                                 ('data_inizio','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <record id="ey_corsi_corso_form_view" model="ir.ui.view">
        <field name="name">ey_corsi.corso.form</field>
        <field name="model">ey_corsi.corso</field>
        <field name="arch" type="xml">
            <form string="Corso">
                <header>
                    <button name="button_compute_corso" string="Valida corso" class="oe_highlight" type="object"
                            invisible="computed"
                            confirm="Vuoi davvero rilasciare gli attestati a chi ha superato il corso?"/>
                    <button name="genera_fattura" string="Genera fattura fornitore" type="object"
                            invisible="invoice_id"/>
                </header>
                <sheet>
                    <div class="oe_title" style="width: 80%">
                        <h1 invisible="id">Nuovo corso</h1>
                        <h1 invisible="not id">
                            <field name="id" invisible="1"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Generale" name="generale">
                            <group>
                                <group>
                                    <field name="created" invisible="1"/>
                                    <field name="template_id" readonly="created" options="{'no_create': True, 'no_open': True}" domain="[('attivo', '=', True)]"/>
                                    <field name="nr_approvazione"/>
                                    <field name="sede_id"/>
                                </group>
                                <group>
                                    <field name="prefisso"/>
                                    <field name="ente_corsi_id"/>
                                    <field name="codice_unico"/>
                                    <field name="pubblicato"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="data_inizio"/>
                                    <field name="annullato"/>
                                </group>
                                <group>
                                    <field name="data_fine"/>
                                    <field name="max_iscritti"/>
                                </group>
                            </group>
                            <group>
                                <field name="prezzo_corso"/>
                            </group>
                            <group string="Personale">
                                <field name="personale" nolabel="1">
                                    <list editable="bottom">
                                        <field name="docente_id"/>
                                        <field name="category_id"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Chiavi">
                                <field name="chiave_ids" nolabel="1">
                                    <list editable="bottom" create="false" delete="false"
                                          decoration-info="is_valore == True">
                                        <field name="descrizione" readonly="1"/>
                                        <field name="chiave" readonly="1"/>
                                        <field name="valore" readonly="not is_valore"/>
                                        <field name="is_valore" column_invisible="1"/>
                                        <field name="priority" readonly="1"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Admin info">
                                <group>
                                    <field name="computed" readonly="1"/>
                                </group>
                                <group>
                                    <field name="product_id" readonly="1"/>
                                    <field name="invoice_id" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="note"/>
                            </group>
                        </page>
                        <page string="Iscritti" name="iscritti">
                            <field name="iscrizione_ids" readonly="1">
                                <list create="false">
                                    <field name="marittimo_id"/>
                                    <field name="data_iscrizione"/>
                                    <field name="data_nascita_marittimo"/>
                                    <field name="luogo_nascita_marittimo_id"/>
                                    <field name="nazionalita_marittimo_id"/>
                                    <field name="importo_versato"/>
                                    <field name="pagato"/>
                                </list>
                            </field>
                            <group>
                                <group/>
                                <group>
                                    <field name="totale_ricavi"/>
                                </group>
                            </group>
                        </page>
                        <page string="Prospetto corso" name="prospetto_corso">
                            <field name="prospetto_corso" create="false">
                                <list>
                                    <field name="marittimo_id" readonly="1"/>
                                    <field name="data_nascita_marittimo"/>
                                    <field name="materiale_consegnato"/>
                                    <field name="preavvertito" readonly="preavvertito"/>
                                    <field name="pagamento_acconto"/>
                                    <field name="importo_versato"/>
                                    <field name="pagato"/>
                                    <field name="corso_superato" string="Freq. 90%"/>
                                    <field name="attestato_frequenza_consegnato"/>
                                    <field name="iscrizione_a_esame" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Costi" name="costi">
                            <field name="costi">
                                <list editable="bottom">
                                    <field name="descrizione_id"/>
                                    <field name="importo"/>
                                    <field name="tipo_costo"/>
                                </list>
                            </field>
                            <group>
                                <group/>
                                <group>
                                    <field name="totale_costi"/>
                                </group>
                            </group>
                        </page>
                        <page string="Allegati" name="allegati">
                            <group string="Loghi">
                                <group>
                                    <field name="logo_azienda" widget="image" readonly="1"/>
                                </group>
                                <group>
                                    <field name="logo_ente" widget="image" readonly="1"/>
                                </group>
                            </group>
                            <group string="Documenti">
                                <field name="documento_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="document" widget="binary" filename="document_fname"/>
                                        <field name="document_fname" column_invisible="1"/>
                                        <field name="tipo_id"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ey_corsi_corso" model="ir.actions.act_window">
        <field name="name">Corsi</field>
        <field name="res_model">ey_corsi.corso</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ey_corsi_corso_search_view"/>
        <field name="context">{'search_default_corsi_attivi_o_futuri': 1}</field>
    </record>

</odoo>

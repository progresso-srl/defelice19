<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ey_corsi_template_corso_list_view" model="ir.ui.view">
        <field name="name">ey_corsi.template_corso.list</field>
        <field name="model">ey_corsi.template_corso</field>
        <field name="arch" type="xml">
            <list string="Template corsi">
                <field name="name"/>
                <field name="prefisso"/>
                <field name="nr_approvazione"/>
                <field name="prezzo_corso"/>
                <field name="max_iscritti"/>
            </list>
        </field>
    </record>

    <record id="ey_corsi_template_corso_search_view" model="ir.ui.view">
        <field name="name">ey_corsi.template_corso.search</field>
        <field name="model">ey_corsi.template_corso</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="prefisso"/>
                <separator/>
                <filter name="tpl_corsi_attivi" string="Attivi" domain="[('attivo','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="ey_corsi_template_corso_form_view" model="ir.ui.view">
        <field name="name">ey_corsi.template_corso.form</field>
        <field name="model">ey_corsi.template_corso</field>
        <field name="arch" type="xml">
            <form string="Template corso">
                <sheet>
                    <notebook>
                        <page string="Generale" name="generale">
                            <group>
                                <group>
                                    <field name="created" invisible="1"/>
                                    <field name="name" readonly="created"/>
                                    <field name="nr_approvazione"/>
                                    <field name="min_iscritti"/>
                                    <field name="attivo"/>
                                </group>
                                <group>
                                    <field name="prefisso"/>
                                    <field name="ente_corsi_id"/>
                                    <field name="max_iscritti"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="data_scadenza_ca"/>
                                </group>
                                <group>
                                    <field name="prezzo_corso"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="con_esame" readonly="created"/>
                                </group>
                                <group>
                                    <field name="template_esame_id" invisible="con_esame == 'no'" required="con_esame == 'si'"/>
                                </group>
                            </group>
                            <group>
                                <field name="numero_attestato_frequenza" readonly="created"/>
                            </group>
                            <group string="Documenti">
                                <field name="documento_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="document" widget="binary" filename="document_fname"/>
                                        <field name="document_fname" column_invisible="1"/>
                                        <field name="tipo_id"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Costi" name="costi">
                            <field name="costo_ids">
                                <list editable="bottom">
                                    <field name="descrizione_id"/>
                                    <field name="importo"/>
                                    <field name="tipo_costo"/>
                                </list>
                            </field>
                        </page>
                        <page string="Loghi e Templates" name="loghi_templates" groups="ey_corsi.group_ey_corsi_template_manager">
                            <group string="Loghi">
                                <group>
                                    <field name="logo_azienda" widget="image"/>
                                </group>
                                <group>
                                    <field name="logo_ente" widget="image"/>
                                </group>
                            </group>
                            <group string="Template attestato di frequenza">
                                <field name="certificato_frequenza" filename="cf_fname" readonly="created"/>
                                <field name="cf_fname" invisible="1"/>
                            </group>
                            <group string="Template registration form">
                                <field name="registration_form" filename="rf_fname" readonly="created"/>
                                <field name="rf_fname" invisible="1"/>
                            </group>
                            <group string="Chiavi">
                                <field name="chiave_ids" nolabel="1">
                                    <list editable="top">
                                        <field name="chiave"/>
                                        <field name="descrizione"/>
                                        <field name="tipo_chiave"/>
                                        <field name="valore" readonly="tipo_chiave == 'campo'"/>
                                        <field name="priority"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Documenti (per report)">
                                <field name="documento_tpl_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="category"/>
                                        <field name="format"/>
                                        <field name="document" widget="binary" filename="document_fname"/>
                                        <field name="document_fname" column_invisible="1"/>
                                        <field name="duplica"/>
                                        <field name="priority"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Info sito" name="info_sito">
                            <group string="Percorsi formativi">
                                <field name="percorsi_formativi" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="carriera_id"/>
                                    </list>
                                </field>
                            </group>
                            <group>
                                <group>
                                    <field name="titolo_corso"/>
                                    <field name="corso_int_est"/>
                                </group>
                                <group>
                                    <field name="descrizione_corso"/>
                                    <field name="pubblicato"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ey_corsi_template_corso" model="ir.actions.act_window">
        <field name="name">Template corsi</field>
        <field name="res_model">ey_corsi.template_corso</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ey_corsi_template_corso_search_view"/>
        <field name="context">{'search_default_tpl_corsi_attivi': 1}</field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ey_corsi_attestato_frequenza_list_view" model="ir.ui.view">
        <field name="name">ey_corsi.attestato_frequenza.list</field>
        <field name="model">ey_corsi.attestato_frequenza</field>
        <field name="arch" type="xml">
            <list string="Attestati di frequenza" create="false" decoration-danger="scaduto == True">
                <field name="corso_id"/>
                <field name="marittimo_id"/>
                <field name="data_rilascio"/>
                <field name="data_scadenza"/>
                <field name="scaduto" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="ey_corsi_attestato_frequenza_search_view" model="ir.ui.view">
        <field name="name">ey_corsi.attestato_frequenza.search</field>
        <field name="model">ey_corsi.attestato_frequenza</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="corso_id"/>
                <field name="marittimo_id"/>
                <filter name="attestati_non_scaduti" string="Non scaduti" domain="[('data_scadenza','&gt;',context_today().strftime('%Y-%m-%d'))]"/>
                <group name="groupby">
                    <filter name="group_attestati_corso" string="Per corso" context="{'group_by':'corso_id'}"/>
                    <filter name="group_attestati_marittimo" string="Per marittimo" context="{'group_by':'marittimo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ey_corsi_attestato_frequenza_form_view" model="ir.ui.view">
        <field name="name">ey_corsi.attestato_frequenza.form</field>
        <field name="model">ey_corsi.attestato_frequenza</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="button_stampa_duplicato" string="Stampa attestato" class="oe_highlight" type="object"
                            confirm="Vuoi davvero stampare l'attestato?"/>
                </header>
                <sheet>
                    <div class="oe_title" style="width: 80%">
                        <h1>
                            <field name="created" invisible="1"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page name="generale">
                            <group>
                                <group>
                                    <field name="corso_id" readonly="created"/>
                                    <field name="marittimo_id" readonly="created"/>
                                    <field name="numero_sequenza" readonly="created"/>
                                </group>
                            </group>
                            <group string="Date">
                                <group>
                                    <field name="data_rilascio"/>
                                </group>
                                <group>
                                    <field name="data_scadenza"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ey_corsi_attestato_frequenza" model="ir.actions.act_window">
        <field name="name">Attestati di frequenza</field>
        <field name="res_model">ey_corsi.attestato_frequenza</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ey_corsi_attestato_frequenza_search_view"/>
        <field name="context">{'search_default_attestati_non_scaduti': 1}</field>
    </record>

</odoo>

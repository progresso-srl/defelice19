<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ey_corsi_certificato_list_view" model="ir.ui.view">
        <field name="name">ey_corsi.certificato.list</field>
        <field name="model">ey_corsi.certificato</field>
        <field name="arch" type="xml">
            <list string="Certificati" create="false" decoration-danger="scaduto == True">
                <field name="descrizione_id"/>
                <field name="marittimo_id"/>
                <field name="data_rilascio"/>
                <field name="data_scadenza"/>
                <field name="document" widget="binary" filename="document_fname"/>
                <field name="document_fname" column_invisible="1"/>
                <field name="scaduto" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="ey_corsi_certificato_search_view" model="ir.ui.view">
        <field name="name">ey_corsi.certificato.search</field>
        <field name="model">ey_corsi.certificato</field>
        <field name="arch" type="xml">
            <search>
                <field name="descrizione_id"/>
                <field name="data_rilascio"/>
                <field name="data_scadenza"/>
                <group name="groupby">
                    <filter name="group_certificato_marittimo" string="Marittimi" context="{'group_by':'marittimo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ey_corsi_certificato_form_view" model="ir.ui.view">
        <field name="name">ey_corsi.certificato.form</field>
        <field name="model">ey_corsi.certificato</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title" style="width: 80%">
                        <h1>
                            <field name="descrizione_id" options="{'no_quick_create': True}"/>
                        </h1>
                        <h3>
                            <field name="marittimo_id"/>
                        </h3>
                    </div>
                    <notebook>
                        <page name="generale">
                            <group string="Date">
                                <group>
                                    <field name="data_rilascio"/>
                                </group>
                                <group>
                                    <field name="id" invisible="1"/>
                                    <field name="data_scadenza" readonly="id"/>
                                </group>
                            </group>
                            <group>
                                <group>
                                    <field name="ente_certificati_id"/>
                                </group>
                                <group>
                                    <field name="document" widget="binary" filename="document_fname"/>
                                    <field name="document_fname" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ey_corsi_certificato" model="ir.actions.act_window">
        <field name="name">Certificati esterni</field>
        <field name="res_model">ey_corsi.certificato</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ey_corsi_certificato_search_view"/>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ey_corsi_certificato_esame_list_view" model="ir.ui.view">
        <field name="name">ey_corsi.certificato_esame.list</field>
        <field name="model">ey_corsi.certificato_esame</field>
        <field name="arch" type="xml">
            <list string="Certificati esame" create="false" decoration-danger="scaduto == True">
                <field name="esame_id"/>
                <field name="marittimo_id"/>
                <field name="data_rilascio"/>
                <field name="data_scadenza"/>
                <field name="scaduto" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="ey_corsi_certificato_esame_search_view" model="ir.ui.view">
        <field name="name">ey_corsi.certificato_esame.search</field>
        <field name="model">ey_corsi.certificato_esame</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="esame_id"/>
                <field name="marittimo_id"/>
                <filter name="certificati_esame_non_scaduti" string="Non scaduti" domain="[('data_scadenza','&gt;',context_today().strftime('%Y-%m-%d'))]"/>
                <group name="groupby">
                    <filter name="group_certificati_esame_corso" string="Per esame" context="{'group_by':'esame_id'}"/>
                    <filter name="group_certificati_esame_marittimo" string="Per marittimo" context="{'group_by':'marittimo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ey_corsi_certificato_esame_form_view" model="ir.ui.view">
        <field name="name">ey_corsi.certificato_esame.form</field>
        <field name="model">ey_corsi.certificato_esame</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="button_stampa_duplicato" string="Stampa certificato" class="oe_highlight" type="object"
                            confirm="Vuoi davvero stampare il certificato?"/>
                </header>
                <sheet>
                    <div class="oe_title" style="width: 80%">
                        <h1>
                            <field name="created" invisible="1"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page name="generale">
                            <group>
                                <group>
                                    <field name="esame_id" readonly="created"/>
                                    <field name="marittimo_id" readonly="created"/>
                                    <field name="numero_sequenza" readonly="created"/>
                                </group>
                                <group>
                                    <field name="document" widget="binary" filename="document_fname"/>
                                    <field name="document_fname" invisible="1"/>
                                </group>
                            </group>
                            <group string="Date">
                                <group>
                                    <field name="data_rilascio"/>
                                </group>
                                <group>
                                    <field name="data_scadenza"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ey_corsi_certificato_esame" model="ir.actions.act_window">
        <field name="name">Certificati esame</field>
        <field name="res_model">ey_corsi.certificato_esame</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ey_corsi_certificato_esame_search_view"/>
        <field name="context">{'search_default_certificati_esame_non_scaduti': 1}</field>
    </record>

</odoo>

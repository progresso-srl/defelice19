<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ey_corsi_template_esame_list_view" model="ir.ui.view">
        <field name="name">ey_corsi.template_esame.list</field>
        <field name="model">ey_corsi.template_esame</field>
        <field name="arch" type="xml">
            <list string="Template esami">
                <field name="name"/>
                <field name="prezzo_interni"/>
                <field name="prezzo_esterni"/>
                <field name="max_iscritti"/>
            </list>
        </field>
    </record>

    <record id="ey_corsi_template_esame_search_view" model="ir.ui.view">
        <field name="name">ey_corsi.template_esame.search</field>
        <field name="model">ey_corsi.template_esame</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="ey_corsi_template_esame_form_view" model="ir.ui.view">
        <field name="name">ey_corsi.template_esame.form</field>
        <field name="model">ey_corsi.template_esame</field>
        <field name="arch" type="xml">
            <form string="Template esame">
                <sheet>
                    <notebook>
                        <page string="Generale" name="generale">
                            <group>
                                <group>
                                    <field name="created" invisible="1"/>
                                    <field name="name" readonly="created"/>
                                </group>
                                <group>
                                    <field name="min_iscritti"/>
                                    <field name="max_iscritti"/>
                                </group>
                            </group>
                            <group>
                                <field name="prezzo_interni"/>
                                <field name="prezzo_esterni"/>
                            </group>
                            <group>
                                <field name="numero_certificato_esame" readonly="created"/>
                            </group>
                            <group string="Documenti">
                                <field name="documento_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="document" widget="binary" filename="document_fname"/>
                                        <field name="document_fname" column_invisible="1"/>
                                        <field name="tipo_id"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Costi" name="costi">
                            <field name="costo_ids">
                                <list editable="bottom">
                                    <field name="descrizione_id"/>
                                    <field name="importo"/>
                                    <field name="tipo_costo"/>
                                </list>
                            </field>
                        </page>
                        <page string="Loghi e Templates" name="loghi_templates" groups="ey_corsi.group_ey_corsi_template_manager">
                            <group>
                                <group>
                                    <field name="logo_azienda" widget="image"/>
                                </group>
                                <group>
                                    <field name="logo_ente" widget="image"/>
                                </group>
                            </group>
                            <group string="Template certificato">
                                <field name="certificato_esame" filename="ce_fname" readonly="created"/>
                                <field name="ce_fname" invisible="1"/>
                            </group>
                            <group string="Template registration form">
                                <field name="registration_form" filename="rf_fname" readonly="created"/>
                                <field name="rf_fname" invisible="1"/>
                            </group>
                            <group string="Chiavi">
                                <field name="chiave_ids" nolabel="1">
                                    <list editable="top">
                                        <field name="chiave"/>
                                        <field name="descrizione"/>
                                        <field name="tipo_chiave"/>
                                        <field name="valore" readonly="tipo_chiave == 'campo'"/>
                                        <field name="priority"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Documenti (per report)">
                                <field name="documento_tpl_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="format"/>
                                        <field name="document" widget="binary" filename="document_fname"/>
                                        <field name="document_fname" column_invisible="1"/>
                                        <field name="duplica"/>
                                        <field name="priority"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ey_corsi_template_esame" model="ir.actions.act_window">
        <field name="name">Template esami</field>
        <field name="res_model">ey_corsi.template_esame</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ey_corsi_template_esame_search_view"/>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ey_corsi_esame_list_view" model="ir.ui.view">
        <field name="name">ey_corsi.esame.list</field>
        <field name="model">ey_corsi.esame</field>
        <field name="arch" type="xml">
            <list string="Esami">
                <field name="template_id"/>
                <field name="data_esame"/>
                <field name="max_iscritti"/>
                <field name="prezzo_interni"/>
                <field name="prezzo_esterni"/>
            </list>
        </field>
    </record>

    <!-- NON portati: in v12 gli altri filtri predefiniti (corsi_terminati/futuri/attivi_o_futuri/
         da_validare) sono commentati direttamente nel sorgente v12, quindi mai attivi:
         resta solo il filtro "esami_attivi" (Esami futuri). -->
    <record id="ey_corsi_esame_search_view" model="ir.ui.view">
        <field name="name">ey_corsi.esame.search</field>
        <field name="model">ey_corsi.esame</field>
        <field name="arch" type="xml">
            <search>
                <field name="template_id"/>
                <separator/>
                <filter name="esami_attivi" string="Esami futuri"
                        domain="[('data_esame','&gt;=',context_today().strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <record id="ey_corsi_esame_form_view" model="ir.ui.view">
        <field name="name">ey_corsi.esame.form</field>
        <field name="model">ey_corsi.esame</field>
        <field name="arch" type="xml">
            <form string="Esame">
                <header>
                    <button name="button_compute_esame" string="Valida esame" class="oe_highlight" type="object"
                            invisible="computed"
                            confirm="Vuoi davvero rilasciare i certificati a chi ha superato l'esame?"/>
                    <button name="genera_fattura" string="Genera fattura fornitore" type="object"
                            invisible="invoice_id"/>
                </header>
                <sheet>
                    <div class="oe_title" style="width: 80%">
                        <h1 invisible="id">Nuovo esame</h1>
                        <h1 invisible="not id">
                            <field name="id" invisible="1"/>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Generale" name="generale">
                            <group>
                                <field name="created" invisible="1"/>
                                <field name="template_id" readonly="created" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group>
                                <group>
                                    <field name="data_esame"/>
                                    <field name="annullato"/>
                                </group>
                                <group>
                                    <field name="max_iscritti"/>
                                </group>
                            </group>
                            <group>
                                <field name="prezzo_interni"/>
                                <field name="prezzo_esterni"/>
                            </group>
                            <group string="Personale">
                                <field name="personale" nolabel="1">
                                    <list editable="bottom">
                                        <field name="docente_id"/>
                                        <field name="category_id"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Chiavi">
                                <field name="chiave_ids" nolabel="1">
                                    <list editable="bottom" create="false" delete="false"
                                          decoration-info="is_valore == True">
                                        <field name="descrizione" readonly="1"/>
                                        <field name="chiave" readonly="1"/>
                                        <field name="valore" readonly="not is_valore"/>
                                        <field name="is_valore" column_invisible="1"/>
                                        <field name="priority" readonly="1"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Admin info">
                                <group>
                                    <field name="computed" readonly="1"/>
                                    <field name="promossi_bocciati" filename="pb_fname"/>
                                    <field name="pb_fname" invisible="1"/>
                                </group>
                                <group>
                                    <field name="product_id" readonly="1"/>
                                    <field name="invoice_id" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="note"/>
                            </group>
                        </page>
                        <page string="Iscritti" name="iscritti">
                            <field name="iscrizione_ids" readonly="1">
                                <list>
                                    <field name="marittimo_id"/>
                                    <field name="data_iscrizione"/>
                                    <field name="data_nascita_marittimo"/>
                                    <field name="luogo_nascita_marittimo_id"/>
                                    <field name="nazionalita_marittimo_id"/>
                                    <field name="importo_versato"/>
                                    <field name="pagato"/>
                                </list>
                            </field>
                            <group>
                                <group/>
                                <group>
                                    <field name="totale_ricavi"/>
                                </group>
                            </group>
                        </page>
                        <page string="Prospetto esame" name="prospetto_esame">
                            <field name="prospetto_esame" create="false">
                                <list>
                                    <field name="marittimo_id"/>
                                    <field name="data_nascita_marittimo"/>
                                    <field name="tipo_iscritto"/>
                                    <field name="pagamento_acconto"/>
                                    <field name="importo_versato"/>
                                    <field name="pagato"/>
                                    <field name="avvertito_esito"/>
                                    <field name="richiesta_ritiro"/>
                                    <field name="esame_superato"/>
                                </list>
                            </field>
                        </page>
                        <page string="Costi" name="costi">
                            <field name="costi">
                                <list editable="bottom">
                                    <field name="descrizione_id"/>
                                    <field name="importo"/>
                                    <field name="tipo_costo"/>
                                </list>
                            </field>
                            <group>
                                <group/>
                                <group>
                                    <field name="totale_costi"/>
                                </group>
                            </group>
                        </page>
                        <page string="Allegati" name="allegati">
                            <group string="Loghi">
                                <group>
                                    <field name="logo_azienda" widget="image" readonly="1"/>
                                </group>
                                <group>
                                    <field name="logo_ente" widget="image" readonly="1"/>
                                </group>
                            </group>
                            <group string="Documenti">
                                <field name="documento_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="document" widget="binary" filename="document_fname"/>
                                        <field name="document_fname" column_invisible="1"/>
                                        <field name="tipo_id"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ey_corsi_esame" model="ir.actions.act_window">
        <field name="name">Esami</field>
        <field name="res_model">ey_corsi.esame</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ey_corsi_esame_search_view"/>
        <field name="context">{'search_default_esami_attivi': 1}</field>
    </record>

</odoo>

<?xml version="1.0"?>
<openerp>
    <data>
        <template id="account_report_mastro">
            <t t-name="report_mastro">
                <t t-call="report.html_container">
                    <t t-call="report.external_layout">
                        <div class="page">
                            <h2>Estratto Conto</h2>
                            <h4>
                                <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/>
                            </h4>
                            <div class="row">
                                <br/>
                            </div>

                            <!--
                                            <div class="row">
                                                <div class="col-xs-3">

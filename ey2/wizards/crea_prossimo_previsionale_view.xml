<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>

        <!-- form view -->
        <record id="ey2_wiz_crea_prossimo_previsionale_form_view" model="ir.ui.view">
            <field name="name">ey2.wiz_crea_prossimo_previsionale.form</field>
            <field name="model">ey2.wiz_crea_prossimo_previsionale</field>
            <field name="arch" type="xml">
                <form string="Crea previsionale da" version="7.0">
                    <group>
                        <group>
                            <field name="contratto_id" readonly="1" />
                        </group>
                        <group>
                            <field name="periodo_precedente_id" domain="[('contratto_id', '=', contratto_id)]"
                                   options="{'no_create_edit': True, 'no_create':True}"/>
                        </group>
                    </group>
                    <footer>
                        <button name="button_crea_previsionale" string="Crea previsionale" type="object"
                                class="oe_highlight"/>
                        o
                        <button string="Annulla" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="ey2_wiz_crea_prossimo_previsionale_action" model="ir.actions.act_window">
            <field name="name">Crea prossimo previsionale</field>
            <field name="res_model">ey2.wiz_crea_prossimo_previsionale</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <record id="ey2_wiz_crea_prossimo_previsionale_form_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ey2_wiz_crea_prossimo_previsionale_form_view"/>
            <field name="act_window_id" ref="ey2_wiz_crea_prossimo_previsionale_action"/>
        </record>

    </data>
</openerp>

<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>

        <!-- tree view -->
        <record id="ey2_agenda_nave_tree_view" model="ir.ui.view">
            <field name="name">ey2.agenda_nave.tree</field>
            <field name="model">ey2.agenda_nave</field>
            <field name="arch" type="xml">
                <tree string="Agenda navi" editable="top">
                    <field name="name"
                           attrs="{'readonly': [('categoria_name', '=', 'Scadenza Certificato Nave')]}" />
                    <field name="categoria_id"
                           attrs="{'readonly': [('categoria_name', '=', 'Scadenza Certificato Nave')]}" />
                    <field name="categoria_name" invisible="1" />
                    <field name="data_alert"
                           attrs="{'readonly': [('categoria_name', '=', 'Scadenza Certificato Nave')]}" />
                    <field name="data_scadenza"
                           attrs="{'readonly': [('categoria_name', '=', 'Scadenza Certificato Nave')]}" />
                    <field name="completato" />
                </tree>
            </field>
        </record>


        <!-- search view -->
        <record id="ey2_agenda_nave_search_view" model="ir.ui.view">
            <field name="name">ey2.agenda_nave.select</field>
            <field name="model">ey2.agenda_nave</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="categoria_id"/>
                    <field name="completato"/>

                    <!-- FILTRI -->
                    <group string="Filtri predefiniti">
                        <filter name="scadenze_visibili" string="Alert"
                            domain="[('data_alert','&lt;=', ((context_today()).strftime('%Y-%m-%d'))),
                                    ('completato', '=', False)]"/>

                    </group>

                    <group string="Raggruppamenti">
                        <filter name="group_agenda_nave_categoria" string="Per categoria" icon="terp-partner"
                                context="{'group_by':'categoria_id'}"/>

                    </group>
                </search>
            </field>
        </record>

        <!-- action per creare un agenda_nave -->
        <record id="ey2_agenda_nave_action" model="ir.actions.act_window">
            <field name="name">Agenda scadenze navi</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ey2.agenda_nave</field>
            <field name="view_type">form</field>
            <field name="context">
                {'search_default_scadenze_visibili': 1}
            </field>
            <field name="filter" eval="True"/>
            <field name="view_mode">tree</field>
        </record>
        <record id="ey2_agenda_nave_tree_view_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="0"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="ey2_agenda_nave_tree_view"/>
            <field name="act_window_id" ref="ey2_agenda_nave_action"/>
        </record>


        <menuitem
                id="ey2_agenda_nave_menu" name="Agenda navi"
                parent="ey.menu_ey_agenda"
                action="ey2_agenda_nave_action"
                sequence="15"
                />


    </data>
</openerp>

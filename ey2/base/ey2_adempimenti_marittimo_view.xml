<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>

        <record id="ey2_adempimento_marittimo_tree_view" model="ir.ui.view">
            <field name="name">ey2.adempimento_marittimo.tree</field>
            <field name="model">ey2.adempimento_marittimo</field>
            <field name="arch" type="xml">
                <list string="Adempimenti marittimo" editable="top">
                    <field name="name" />
                    <field name="tipo_id" />
                </list>
            </field>
        </record>

        <record id="ey2_adempimento_marittimo_search_view" model="ir.ui.view">
            <field name="name">ey2.adempimento_marittimo.select</field>
            <field name="model">ey2.adempimento_marittimo</field>
            <field name="arch" type="xml">
                <search string="Search...">
                    <field name="name" />
                    <field name="tipo_id" />

                    <group string="Group by...">
                        <filter name="group_ey2_am_tipo" string="Tipo adempimento" icon="terp-partner"
                                context="{'group_by':'tipo_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ey2_adempimento_marittimo_action" model="ir.actions.act_window">
            <field name="name">Adempimenti marittimo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ey2.adempimento_marittimo</field>
            <field name="view_type">form</field>
            <field name="filter" eval="True"/>
            <field name="view_mode">list</field>
        </record>
        <record id="ey2_adempimento_marittimo_tree_view_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="0"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="ey2_adempimento_marittimo_tree_view"/>
            <field name="act_window_id" ref="ey2_adempimento_marittimo_action"/>
        </record>

        <!--crea la voce del menu -->
        <menuitem
                id="ey2_adempimenti_marittimo_menu" name="Adempimenti marittimo"
                parent="menu_ey2_adempimenti"
                action="ey2_adempimento_marittimo_action"
                sequence="10"
        />


    </data>
</openerp>

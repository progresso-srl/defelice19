<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Macro helper: una list+form minimale per ogni lookup ──── -->

    <record id="view_porto_list" model="ir.ui.view">
        <field name="name">ey_base.porto.list</field>
        <field name="model">ey_base.porto</field>
        <field name="arch" type="xml">
            <list string="Porti" editable="bottom"><field name="name"/></list>

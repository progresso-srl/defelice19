                        <!--## credit-->
                        <div class="act_as_cell amount">
                            <t t-if="type == 'account_type'">
                                <t t-set="domain" t-value="[('account_id', '=', account_or_partner_object.account_id.id),                                      ('date', '&lt;', o.date_from.strftime('%Y-%m-%d')),                                      ('credit', '&lt;&gt;', 0)]"/>

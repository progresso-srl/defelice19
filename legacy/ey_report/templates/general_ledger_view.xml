                                <span>
                                    <a t-att-data-active-id="line.move_line_id.id" t-att-data-res-model="res_model" class="o_account_financial_reports_web_action" style="color: black;">
                                        <t t-raw="line.label"/>
                                    </a>
                                </span>
                            </div>
                            <!--## cost_center

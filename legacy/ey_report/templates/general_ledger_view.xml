                                </t>
                                <t t-if="type == 'partner_type'">
                                    <t t-set="domain"
                                    t-value="[('account_id', '=', account_or_partner_object.report_account_id.account_id.id),
                                                ('partner_id', '=', account_or_partner_object.partner_id.id),
                                                ('date', '&lt;', o.date_from)]"/>

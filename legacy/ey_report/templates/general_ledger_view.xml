                    <!-- Display table headers for lines -->
                    <div class="act_as_thead">
                        <div class="act_as_row labels">
                            <!--## date-->
                            <div class="act_as_cell first_column" style="width: 3.51%;">Data</div>
                            <!--## move
                            <div class="act_as_cell" style="width: 8.03%">Registrazione</div> -->
                            <!--## journal-->
                            <!--<div class="act_as_cell" style="width: 4.13%;">Registro</div> -->
                            <!--## account code-->
                            <!--<div class="act_as_cell" style="width: 4.75%;">Conto</div> -->
                            <!--## account code-->
                            <!-- <div class="act_as_cell" style="width: 8.89%;">Imposte</div> -->
                            <!--## partner-->
                            <!--<div class="act_as_cell" style="width: 12.01%;">Partner</div> -->
                            <!--## ref - label-->
                            <div class="act_as_cell" style="width: 22.9%;">Rif. - Etichetta</div>
                            <!--<t t-if="show_cost_center">
                                <div class="act_as_cell" style="width: 8.03%;">Cost center</div>
                            </t>-->
                            <t t-if="show_analytic_tags">
                                <!--## analytic tags-->
                                <div class="act_as_cell" style="width: 4.75%;">Etichette</div>
                            </t>
                            <!--## matching_number-->
                            <div class="act_as_cell" style="width: 2.41%;">Ric.</div>
                            <!--## debit-->
                            <div class="act_as_cell amount" style="width: 6.02%;">Dare</div>
                            <!--## credit-->
                            <div class="act_as_cell amount" style="width: 6.02%;">Avere</div>
                            <!--## balance cumulated-->
                            <div class="act_as_cell amount" style="width: 6.02%;">Saldo progr.</div>
                            <!--t t-if="foreign_currency">
                                <div class="act_as_cell" style="width: 2.08%;">Val.</div>
                                <div class="act_as_cell amount" style="width: 5.19%;">Importo val.</div>
                            </t>-->
                        </div>
                    </div>
                    <!-- Display first line with initial balance -->
                    <div class="act_as_row lines">
                        <!--## date-->
                        <div class="act_as_cell"/>
                        <!--## move
                        <div class="act_as_cell"/> -->
                        <!--## journal
                        <div class="act_as_cell"/> -->
                        <!--## account code

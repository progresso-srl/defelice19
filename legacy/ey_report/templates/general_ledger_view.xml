                                <t t-set="domain" t-value="[('account_id', '=', account_or_partner_object.report_account_id.account_id.id),                                      ('partner_id', '=', account_or_partner_object.partner_id.id),                                      ('date', '&lt;', o.date_from.strftime('%Y-%m-%d')),                                      ('debit', '&lt;&gt;', 0)]"/>
                                <span>
                                    <a t-att-data-domain="domain" t-att-data-res-model="'account.move.line'" class="o_account_financial_reports_web_action_monetary_multi" style="color: black;">
                                        <t t-if="o.set_to_zero == False" t-raw="account_or_partner_object.initial_debit" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                        <t t-elif="o.set_to_zero == True" t-raw="initial_debit_zero" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </a>
                                </span>
                            </t>

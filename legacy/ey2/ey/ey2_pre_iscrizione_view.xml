<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>


        <!-- tree view -->
        <record id="ey2_pre_iscrizione_tree_view" model="ir.ui.view">
            <field name="name">ey2.pre_iscrizione.tree</field>
            <field name="model">ey2.pre_iscrizione</field>
            <field name="arch" type="xml">
                <list string="Iscrizioni">
                    <field name="template_id" />
                    <field name="marittimo_id" />
                    <field name="data_iscrizione" />
                    <field name="data_inizio_corso" />
                    <field name="data_fine_corso" />
                    <field name="prezzo_corso"/>
                    <field name="esito" />
                </list>
            </field>
        </record>


        <!-- search view -->
        <record id="ey2_pre_iscrizione_search_view" model="ir.ui.view">
            <field name="name">ey2.pre_iscrizione.select</field>
            <field name="model">ey2.pre_iscrizione</field>
            <field name="arch" type="xml">
                <search>
                    <field name="template_id" />
                    <field name="corso_id" />
                    <field name="marittimo_id" />

                    <filter name="cpreiscrizioni_non_annullate" string="Non annullate"
                            domain="[('esito','!=', 'Annullata')]"/>

                    <!-- FILTRI -->
                    <group string="Filtri predefiniti">
                        <filter name="pre_iscrizioni_corsi_attivi" string="Corsi attivi"
                            domain="[('data_inizio_corso','&lt;=', ((context_today()).strftime('%Y-%m-%d'))),
                            ('data_fine_corso','&gt;=', ((context_today()).strftime('%Y-%m-%d')))]"/>
                        <filter name="pre_iscrizioni_corsi_terminati" string="Corsi terminati"
                            domain="[('data_fine_corso','&lt;=', ((context_today()).strftime('%Y-%m-%d')))]"/>
                        <filter name="pre_iscrizioni_corsi_futuri" string="Corsi futuri"
                            domain="[('data_inizio_corso','&gt;=', ((context_today()).strftime('%Y-%m-%d')))]"/>
                        <filter name="iscrizioni_pagate" string="Pagate"
                            domain="[('pagato','=', True)]"/>
                        <filter name="iscrizioni_da_pagare" string="Da pagare"
                            domain="[('pagato','=', False)]"/>
                        <filter name="pre_iscrizioni_corsi_attivi_o_futuri" string="Corsi attivi o futuri"
                                domain="['|', '&amp;',
                                ('data_inizio_corso','&lt;=', ((context_today()).strftime('%Y-%m-%d'))),
                                ('data_fine_corso','&gt;=', ((context_today()).strftime('%Y-%m-%d'))),
                                ('data_inizio_corso','&gt;=', ((context_today()).strftime('%Y-%m-%d')))]" />
                    </group>
                    <!-- RAGGRUPPAMENTI -->
                    <group string="Raggruppamenti">
                        <filter name="group_pre_iscrizione_corso" string="Per corso" icon="terp-partner"
                            context="{'group_by':'corso_id'}"/>
                        <filter name="group_cpre_iscrizione_template_id" string="Per template" icon="terp-partner"
                            context="{'group_by':'template_id'}"/>
                        <filter name="group_pre_iscrizione_marittimo" string="Per marittimo" icon="terp-partner"
                            context="{'group_by':'marittimo_id'}"/>
                        <filter name="group_pre_iscrizione_date" string="Mensile" icon="terp-partner"
                                context="{'group_by':'data_iscrizione'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- form view -->
        <record id="ey2_pre_iscrizione_form_view" model="ir.ui.view">
            <field name="name">ey2.pre_iscrizione.form</field>
            <field name="model">ey2.pre_iscrizione</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <form string="Iscrizioni" version="7.0">
                    <header>
                        <button string="Stampa reg. form" name="stampa_reg_form"
                                type="object" attrs="{'invisible': [('rf_compilato', '!=', False), ('corso_id', '!=', False)]}" />
                        <button string="Crea iscrizione" name="crea_iscrizione"
                                type="object" attrs="{'invisible': [('iscrizione_id', '!=', False), ('corso_id', '!=', False)]}" />
                    </header>
                    <sheet>
                        <notebook>
                            <page>
                                <group>
                                    <field name="created" invisible="1" />
                                    <group>
                                        <field name="template_id"
                                               attrs="{'readonly': [('created', '=', True)]}" />
                                        <field name="corso_id"
                                                domain="[('data_inizio', '&gt;=', (context_today()).strftime('%Y-%m-%d')), ('computed', '=', False)]"
                                                attrs="{'readonly': [('template_id', '=', False)]}"
                                                options="{'no_create': True}" />
                                        <field name="data_iscrizione" />
                                        <field name="esame_id"  />
                                    </group>
                                    <group>
                                        <field name="marittimo_id" attrs="{'readonly': [('created', '=', True)]}"
                                            context="{'default_anagrafica_ey': True}"/>
                                        <field name="destinatario_id"
                                                context="{'default_is_company': 1, 'default_customer': 1, 'default_supplier': 0}"
                                                domain="[('customer', '=', True)]" />
                                        <field name="prezzo_corso" />
                                        <field name="prezzo_scontato" />
                                    </group>
                                </group>
                                <group string="Documenti marittimo">
                                    <field name="documento_ids" readonly="1" nolabel="1"/>
                                </group>
                                <group string="Registration form compilato">
                                    <field name="rf_compilato" filename="rf_fname"/>
                                    <field name="rf_fname" invisible="1"/>
                                </group>
                                <group>
                                    <field name="iscrizione_id" readonly="1" />
                                </group>
                                <group string="Esito">
                                    <field name="esito" />
                                    <field name="note_esito" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- action per creare un iscrizione -->
        <record id="ey2_pre_iscrizione_action" model="ir.actions.act_window">
            <field name="name">Iscrizioni</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ey2.pre_iscrizione</field>
            <field name="view_type">form</field>
            <field name="filter" eval="True"/>
            <field name="context">
                {'search_default_cpreiscrizioni_non_annullate': 1}
            </field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="ey2_pre_iscrizione_tree_view_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="0"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="ey2_pre_iscrizione_tree_view"/>
            <field name="act_window_id" ref="ey2_pre_iscrizione_action"/>
        </record>
        <record id="ey2_pre_iscrizione_form_view_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ey2_pre_iscrizione_form_view"/>
            <field name="act_window_id" ref="ey2_pre_iscrizione_action"/>
        </record>

        <!--crea la voce del menu -->
        <menuitem
                id="ey2_pre_iscrizione_menu" name="Preiscrizioni ai corsi"
                parent="ey.menu_ey_corsi"
                action="ey2_pre_iscrizione_action"
                sequence="29"
                />


    </data>
</openerp>

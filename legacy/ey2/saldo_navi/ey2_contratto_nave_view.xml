<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>

        <record id="ey2_contratto_nave_tree_view" model="ir.ui.view">
            <field name="name">ey2.contratto_nave.tree</field>
            <field name="model">ey2.contratto_nave</field>
            <field name="arch" type="xml">
                <tree string="Contratti">
                    <field name="nave_id"/>
                    <field name="mese_inizio"/>
                    <field name="anno_inizio"/>
                    <field name="currency_id" invisible="1" />
                    <field name="attivo"/>
                    <field name="periodo_id"/>
                    <field name="saldo_attuale" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                </tree>
            </field>
        </record>

        <record id="ey2_contratto_nave_search_view" model="ir.ui.view">
            <field name="name">ey2.contratto_nave.select</field>
            <field name="model">ey2.contratto_nave</field>
            <field name="arch" type="xml">
                <search string="Search...">
                    <field name="nave_id"/>

                    <filter name="ey2_con_nav_attivi" string="Attivi"
                            domain="[('attivo','=', True)]"/>
                    <filter name="ey2_con_nav_non_attivi" string="Non attivi"
                            domain="[('attivo','=', False)]"/>

                </search>
            </field>
        </record>

        <record id="ey2_contratto_nave_form_view" model="ir.ui.view">
            <field name="name">ey2.contratto_nave.form</field>
            <field name="model">ey2.contratto_nave</field>
            <field name="arch" type="xml">
                <form string="Contratto" version="7.0">
                    <header>
                        <button name="button_crea_prossimo_previsionale" string="Crea prossimo previsionale" type="object"
                                class="oe_highlight" attrs="{'readonly': [('attivo', '!=', False)]}"/>
                    </header>
                    <sheet>
                        <div class="oe_title" style="width: 80%">
                            <h1 attrs="{'invisible': [('id', '!=', False)]}">Nuovo contratto</h1>
                            <h1>
                                <field name="id" invisible="1"/>
                                <field name="name" placeholder="Nome"
                                       attrs="{'invisible': [('id', '=', False)]}"/>
                            </h1>
                        </div>
                        <field name="currency_id" invisible="1"/>
                        <group string="Dati contratto">
                            <group>
                                <field name="mese_inizio"
                                       attrs="{'readonly': [('id', '!=', False)]}"/>
                                <field name="nave_id"
                                       attrs="{'readonly': [('id', '!=', False)]}"/>
                                <field name="saldo_iniziale" widget='monetary' options="{'currency_field': 'currency_id'}"
                                       attrs="{'readonly': [('id', '!=', False)]}"/>
                                <field name="currency_id"
                                       attrs="{'readonly': [('id', '!=', False)]}"/>
                            </group>
                            <group>
                                <field name="anno_inizio"
                                       attrs="{'readonly': [('id', '!=', False)]}"/>
                                <field name="periodo_id"
                                       attrs="{'readonly': [('id', '!=', False)]}"/>
                                <field name="attivo"/>
                            </group>
                        </group>
                        <group>
                            <group class="oe_subtotal_footer" colspan="2" name="sale_total">
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="saldo_attuale"/>
                                </div>
                                <field name="saldo_attuale" string="Saldo attuale" nolabel="1"
                                       class="oe_subtotal_footer_separator"
                                       widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <group/>
                        </group>
                        <group string="Previsionali">
                            <field name="previsionale_ids" nolabel="1">
                                <tree create="false" delete="false">
                                    <field name="mese_inizio"/>
                                    <field name="anno_inizio"/>
                                    <field name="currency_id" invisible="1" />
                                    <field name="totale_richiesto" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                                    <field name="totale_speso" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                                    <field name="bilancio" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                                </tree>
                            </field>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- action per creare un tpl -->
        <record id="ey2_contratto_nave_action" model="ir.actions.act_window">
            <field name="name">Contratti</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ey2.contratto_nave</field>
            <field name="view_type">form</field>
            <field name="context">{'search_default_ey2_con_nav_attivi': 1}</field>
            <field name="filter" eval="True"/>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="ey2_contratto_nave_tree_view_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="0"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="ey2_contratto_nave_tree_view"/>
            <field name="act_window_id" ref="ey2_contratto_nave_action"/>
        </record>
        <record id="ey2_contratto_nave_form_view_act" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="ey2_contratto_nave_form_view"/>
            <field name="act_window_id" ref="ey2_contratto_nave_action"/>
        </record>

        <!--crea la voce del menu -->
        <menuitem
                id="ey2_contratto_nave_menu" name="Contratti"
                parent="menu_ey2_contratti_saldo_navi"
                action="ey2_contratto_nave_action"
                sequence="10"
        />

    </data>
</openerp>

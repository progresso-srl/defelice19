<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>


        <!-- tree view -->
        <record id="config_tpl_documento_tpl_tree_view" model="ir.ui.view">
            <field name="name">config_tpl.documento_tpl.tree</field>
            <field name="model">config_tpl.documento_tpl</field>
            <field name="arch" type="xml">
                <list string="Documenti" delete="false">
                    <field name="name" />
                    <field name="format" />
                    <field name="document_fname" />
                    <field name="duplica" />
                    <field name="priority" placeholder="Priorità" />
                </list>
            </field>
        </record>


        <!-- search view -->
        <record id="config_tpl_documento_tpl_search_view" model="ir.ui.view">
            <field name="name">config_tpl.documento_tpl.select</field>
            <field name="model">config_tpl.documento_tpl</field>
            <field name="arch" type="xml">
                <search>
                    <field name="tpl_id" />
                    <field name="name" />
                </search>
            </field>
        </record>


        <!-- form view -->
        <record id="config_tpl_documento_tpl_form_view" model="ir.ui.view">
            <field name="name">config_tpl.documento_tpl.form</field>
            <field name="model">config_tpl.documento_tpl</field>
            <field eval="7" name="priority"/>
            <field name="arch" type="xml">
                <form string="Documenti" version="7.0">
                    <sheet>
                        <div class="oe_title" style="width: 80%">
                            <h1>
                                <field name="id" invisible="1" />
                                <field name="name" placeholder="Nome"
                                        attrs="{'readonly': [('id', '!=', False)]}"/>
                            </h1>
                            <h4>
                                <label for="priority">Priorità</label>
                                <field name="priority" placeholder="Priorità" />
                            </h4>
                        </div>
                        <notebook>
                            <page>
                                <group>
                                    <group>
                                        <field name="format" attrs="{'readonly': [('id', '!=', False)]}"/>
                                        <field name="duplica" />
                                    </group>
                                    <group>
                                        <field name="document" filename="document_fname"
                                            attrs="{'invisible': [('id', '!=', False)]}" />
                                        <field name="document_fname"
                                            attrs="{'invisible': [('id', '=', False)], 'readonly': [('id', '!=', False)]}" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


    </data>
</openerp>
